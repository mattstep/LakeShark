# SSH client overlay: add after the board defaults.
#   -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/t_display_p4.defaults;boards/ssh.defaults"
# (mbedTLS threading, which libssh needs, is on in sdkconfig.defaults.)
# This is the client only; CONFIG_LS_SSH (the network terminal's SSH server)
# stays as the board sets it.
CONFIG_LS_SSH_CLIENT=y
