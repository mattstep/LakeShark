# Wired Ethernet overlay: add after boards/t_display_p4.defaults.
# See docs/ETHERNET.md.
CONFIG_LS_ETH=y
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_PHY_INTERFACE_RMII=y
# The EMAC's DMA rings are always internal RAM, and the P4 defaults (20 RX +
# 10 TX buffers of 512 B, 64 B descriptor each) take 17 KB of the ~62 KB
# left after boot. The P4's EMAC RX FIFO is small (why IDF defaults to 20),
# so the RX ring is what absorbs the rx task being scheduled late: 8 buffers
# hold 2.7 full-size frames where 6 would hold 2. 4 TX buffers hold one
# full-size frame plus a small one; lwIP is the only sender and TCP backs
# off on a refused segment. Total 12 x 576 B = 6.75 KB. The cost is burst
# throughput, which map tiles, OTA and the file page do not need.
CONFIG_ETH_DMA_BUFFER_SIZE=512
CONFIG_ETH_DMA_RX_BUFFER_NUM=8
CONFIG_ETH_DMA_TX_BUFFER_NUM=4
